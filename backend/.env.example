PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/quantum_mobile
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d
CLIENT_URL=http://localhost:5173

# Email Notifications (Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

# Stripe Payments Sandbox Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PayHere Sri Lanka Sandbox Configuration
PAYHERE_MERCHANT_ID=your_payhere_merchant_id
PAYHERE_MERCHANT_SECRET=your_payhere_merchant_secret
PAYHERE_MODE=sandbox

# Google OAuth 2.0 Client ID (Web Application)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

